# Discord bot for the Minecraft control panel.
# Copy to .env on the server and fill in. Keep .env chmod 600 — the token and
# the panel password are both in here.

# ---- Discord ---------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Right-click your Discord server -> Copy Server ID (needs Developer Mode on).
DISCORD_GUILD_ID=

# Channel for "server is online / stopped" posts.
# Leave empty to turn announcements off.
DISCORD_ANNOUNCE_CHANNEL_ID=

# Role allowed to run /start /stop /restart.
# EMPTY = everyone in the guild may. Set a role id to lock it down later.
MCBOT_ADMIN_ROLE_ID=

# ---- Panel API -------------------------------------------------------
# The bot runs on the same box as the panel, so it talks to it over localhost.
# This deliberately bypasses nginx/openresty and TLS.
PANEL_URL=http://127.0.0.1:8081

# Same credentials as /srv/panel/.env
PANEL_USER=
PANEL_PASS=

# Shown in /status and in the "server is online" post.
MC_PUBLIC_ADDRESS=178.17.3.31
